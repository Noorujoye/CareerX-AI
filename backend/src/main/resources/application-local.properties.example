# Local-only overrides for development.
# Copy to: application-local.properties (DO NOT COMMIT)
# Run with: --spring.profiles.active=local

# Database
spring.datasource.url=jdbc:mysql://localhost:3306/login_db?createDatabaseIfNotExist=true
spring.datasource.username=root
spring.datasource.password=CHANGE_ME

# JWT
# Must be >= 32 characters
app.jwt.secret=CHANGE_ME
# app.jwt.expiration-ms=86400000

# Tip (PowerShell): generate a strong secret
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
