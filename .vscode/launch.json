{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "LoginSystemApplication",
      "request": "launch",
      "mainClass": "com.noorain.login_system.LoginSystemApplication",
      "projectName": "login-system"
    },
    {
      "type": "java",
      "name": "Backend (local profile)",
      "request": "launch",
      "mainClass": "com.noorain.login_system.LoginSystemApplication",
      "projectName": "backend",
      "vmArgs": "-Dspring.profiles.active=local",
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "DB_USERNAME": "root"
      }
    }
  ]
}
